# Build context for packages/server is the REPO ROOT (see packages/server/docker-compose.yml),
# so the ignore rules have to live here — Docker only reads .dockerignore from the
# context root, and packages/server/.dockerignore is invisible to it.
#
# Patterns are unanchored so they match at any depth: `node_modules` excludes the root
# install AND every packages/*/node_modules.

node_modules
.git
.gitignore

# Never ship secrets into an image layer.
.env
.env.local
.env.*.local

# Build output and caches — the image builds its own.
.mastra
.next
.turbo
dist
build
coverage
*.log
*.tsbuildinfo

# Local databases and their sidecar files.
*.db
*.db-shm
*.db-wal

# The web package is not part of the server image.
packages/web

# Task tracker + docs — not needed to build or run the server.
.beads
docs
scripts
SPEC
README.md

.DS_Store
.vscode
.idea
