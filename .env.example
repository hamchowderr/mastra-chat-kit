# mastra-chat-kit — root env reference. Copy per-package as needed.
#
# Tests need NOTHING here: server Tier-1 tests inject their env via vitest.config
# (USE_AIMOCK + in-memory store), and web component tests are jsdom-only.
#
# To RUN the stack locally (live chat), the server needs these:

# --- packages/server/.env ---
# Deterministic, free dev: route LLM calls to AIMock instead of a real provider.
USE_AIMOCK=true
AIMOCK_URL=http://localhost:4010
# Start AIMock alongside the server:  pnpm --filter @mastra-chat-kit/server dev:mock

# env.ts requires these even under AIMock (validated before AIMock is configured):
APP_SECRET=replace-with-a-32+-character-random-string
# Memory/threads/observability + vectors run on libSQL — defaults to a local
# file: DB (./mastra.db), so nothing's needed here for local dev. Point at a
# Turso URL for prod, or see docs/postgres.md to switch to Postgres.
# TURSO_DATABASE_URL=file:./mastra.db
# A provider key must be PRESENT (value can be a placeholder under AIMock):
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# --- packages/web/.env.local  (template: packages/web/.env.local.example) ---
# Where the web proxy route forwards Agent-mode chat. Default if unset:
# http://localhost:4111 — so local dev needs nothing. REQUIRED on a deployment,
# where that fallback resolves to nothing and every proxied request fails.
MASTRA_SERVER_URL=http://localhost:4111
