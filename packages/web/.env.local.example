# packages/web — copy to `.env.local`:
#     cp packages/web/.env.local.example packages/web/.env.local
#
# Nothing here is secret. The web app holds no provider keys — it is a pure
# frontend that proxies to a Mastra server, and the keys live on that server.

# Where the same-origin route handlers in app/api/* forward to.
#
# Optional for local dev — every handler falls back to http://localhost:4111,
# which is where `pnpm dev` puts the server, so the stack works unset.
#
# REQUIRED FOR ANY DEPLOYMENT. The fallback is a localhost that does not exist
# on a hosting platform, so leaving this unset does not fail loudly: the app
# builds, deploys and renders, and then every request 500s or hangs against a
# server that is not there. Set it on the hosting project, not just here.
MASTRA_SERVER_URL=http://localhost:4111

# --- Scripts only. Not needed to run the app. ---

# scripts/screenshot.mjs — which origin to capture the README images from.
# Defaults to the local dev server.
# SHOT_BASE_URL=http://localhost:3000

# scripts/registry-smoke.mjs — port for the throwaway consumer project it
# scaffolds and builds. Only set this if the default collides with something.
# SMOKE_PORT=3100
