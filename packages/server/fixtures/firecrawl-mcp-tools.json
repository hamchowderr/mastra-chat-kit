                "type": {
                  "type": "string",
                  "enum": [
                    "wait",
                    "screenshot",
                    "scroll",
                    "scrape",
                    "click",
                    "write",
                    "press",
                    "executeJavascript",
                    "generatePDF"
                  ]
                },
                "selector": {
                  "type": "string"
                },
                "milliseconds": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": ["up", "down"]
                },
                "script": {
                  "type": "string"
                },
                "fullPage": {
                  "type": "boolean"
                }
              },
              "required": ["type"]
            }
          },
          "mobile": {
            "type": "boolean"
          },
          "skipTlsVerification": {
            "type": "boolean"
          },
          "removeBase64Images": {
            "type": "boolean"
          },
          "location": {
            "type": "object",
