              },
              "skipTlsVerification": {
                "type": "boolean"
              },
              "removeBase64Images": {
                "type": "boolean"
              },
              "location": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "storeInCache": {
                "type": "boolean"
              },
              "zeroDataRetention": {
                "type": "boolean"
              },
              "maxAge": {
                "type": "number"
